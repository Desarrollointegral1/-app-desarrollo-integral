    "test:watch": "vitest",
    "test:node": "node --test src/utils/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@supabase/supabase-js": "^2.101.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^1.26.0",
    "pg": "^8.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.4",
    "vitest": "^4.1.10"
  }
}
