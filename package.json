{
  "name": "app-desarrollo-integral",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "setup-migrations": "node setup-migrations.js",
    "deploy": "git add App.jsx services/supabase.js src/ public/ package.json && git diff --cached --quiet || git commit -m \"deploy: update $(date +%Y-%m-%d)\" && git push origin main && npx vercel --prod",
